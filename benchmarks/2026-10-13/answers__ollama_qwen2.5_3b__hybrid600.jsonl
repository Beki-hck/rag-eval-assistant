{"id": "ps-03", "answerable": true, "answer": "Preference-studio produces a DPO JSONL format for DPO training, with filters for minimum labels, agreement, and margin.", "sources": ["preference-studio#Features#3", "preference-studio#Preference Studio#0", "preference-studio#Command line#0"], "refused": false, "retrieved_relevant": true, "correctness": 0.0, "grounding": null, "faithfulness": 1.0}
{"id": "ps-04", "answerable": true, "answer": "Preference-studio computes Krippendorff's α, Fleiss' κ, pairwise Cohen's κ, percent agreement, left-side pick rate, tie rate, and median time per rater, and label split, majority, agreement, mean score per pair.", "sources": ["preference-studio#Why I built it#0", "preference-studio#Metric validation with simulated raters#0", "preference-studio#Features#2"], "refused": false, "retrieved_relevant": true, "correctness": 1.0, "grounding": null, "faithfulness": 0.5}
{"id": "ps-05", "answerable": true, "answer": "Preference-studio detects a rater who always picks the left answer by using a position-bias metric. This metric identifies raters who consistently choose the left option, indicating potential bias, and flags them for review.", "sources": ["preference-studio#Why I built it#0", "preference-studio#Metric validation with simulated raters#1", "preference-studio#Metric validation with simulated raters#2"], "refused": false, "retrieved_relevant": true, "correctness": 0.0, "grounding": null, "faithfulness": 1.0}
{"id": "ps-06", "answerable": true, "answer": "Preference Studio is built with Python for the backend and JavaScript/TypeScript for the frontend. It uses PostgreSQL for database storage.", "sources": ["preference-studio#Why I built it#0", "preference-studio#Quick start#0", "preference-studio#Preference Studio#0"], "refused": false, "retrieved_relevant": false, "correctness": 0.0, "grounding": null, "faithfulness": 0.5}
